# Copy thành .env rồi điền. .env đã được .gitignore, KHÔNG commit.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Chỉ khi dùng credential tạm (SSO):
# AWS_SESSION_TOKEN=replace-me

# Tùy chọn (docker compose đọc):
# OTEL_VERSION=0.130.0
# OTEL_CONFIG=config.yaml          # hoặc config-transform.yaml
